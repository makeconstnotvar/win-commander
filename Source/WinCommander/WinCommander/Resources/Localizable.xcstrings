        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This is a trial version of Win Commander.\nTo continue using this software after the 30-day trial period, you have to either buy a license or install the paid version from Mac App Store.\nThis window appears only in the trial version."
