        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Это пробная версия Win Commander.\nЧтобы продолжить использование этого продукта после окончания пробного периода в 30 дней, Вам нужно купить лицензию или установить платную версию из Mac App Store.\nЭто окно появляется только в пробной версии."
          }
        }
      }
